{
  "name": "nfc-restaurant-ordering",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
